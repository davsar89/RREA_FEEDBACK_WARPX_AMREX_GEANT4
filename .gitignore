# Python/cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments
.venv/
venv/
env/
*.egg-info/
external/

# Secrets and remote access notes
OLIVIA_SECRETS.enc
REMOTE_OLIVIA.md
.olivia_known_hosts
QR_olivia_ssh.jpg
olivia.env
.olivia.env
.local_secrets/
.gitlab_uib_token.txt
gitlab_uib_token.txt
*totp*
*otp*
*secret*
# Credential-shaped names the wildcards above miss.  Both cases are listed
# because gitignore matching is case-sensitive wherever core.ignorecase=false
# (the Linux default), so lowercase-only patterns silently stop protecting
# anything once the repo is cloned off Windows.
*token*
*TOKEN*
*password*
*PASSWORD*
*credential*
*CREDENTIAL*
*SECRET*
*TOTP*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
.netrc

# Large/copyrighted local references
*.pdf
*.png
EFIELD_profile/*.png

# Literature lives in one tracked directory. Everything else matching *.pdf
# stays ignored; the two guide PDFs are force-added (see docs/README.md).
!docs/papers/
!docs/papers/**/*.pdf

# MAKE_ARCHIVE.py output.
/rrea_warpx_amrex_*.zip
/rrea_warpx_amrex_*.tar.gz

# WarpX/openPMD/generated simulation outputs
runs*/
results/
validation/
# ...except the tracked table bundle's holdout evidence, which shares
# the name.  Negating the directory, not the files: git cannot
# re-include a path whose parent directory is excluded.
!/rrea_transport_tables/schema6/production/validation/
tmp/
warpx_used_inputs*
diags/
*.bp
*.bp4
*.bp5
*.h5
*.hdf5
*.vtk
*.vti
*.vtr
*.pmd

# Native build directories
build_smoke/
native_amrex_rrea/build_smoke/
native_amrex_rrea/build/

# AMReX profiler backtraces
Backtrace.*

# Logs and local scratch
.codex_tmp/
*.log
*.out
*.err
*.tmp
*.bak

# Vendored PARMA model code + data (rrea_parma_source.py): its *.out tables
# must survive the global *.out ignore above (last match wins); only the
# locally built evaluator binary and Fortran module files stay untracked.
!/rrea_parma_upstream/**
/rrea_parma_upstream/parma_electron_query
/rrea_parma_upstream/*.mod
/rrea_parma_upstream/*.o

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# LaTeX build artifacts
/output/
docs/*.aux
docs/*.toc
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk
# Rendered videos and product folders are build products, never sources.
*.mp4
/e[0-9]*_radio/
/e[0-9]*_videos/
